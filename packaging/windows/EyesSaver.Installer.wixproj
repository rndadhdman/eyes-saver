<!-- WiX 5 (MS-RL licensed). WiX 6 and later need an extra EULA acceptance, so stay on 5.x. -->
<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <ProductVersion Condition="'$(ProductVersion)' == ''">2.1.0</ProductVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\publish\win-x64\</PublishDir>
    <OutputName>EyesSaver-$(ProductVersion)-win-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'));IconFile=$(MSBuildThisFileDirectory)..\..\src\EyesSaver.App\Assets\EyesSaver.ico</DefineConstants>
    <SuppressValidation>false</SuppressValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
