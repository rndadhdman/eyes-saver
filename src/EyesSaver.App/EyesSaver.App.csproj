<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>EyesSaver</AssemblyName>
    <RootNamespace>EyesSaver.App</RootNamespace>
    <ApplicationIcon>Assets\EyesSaver.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>2.1.0</Version>
    <Product>Eyes Saver</Product>
    <Company>Eyes Saver</Company>
    <Description>Screen tint for every display</Description>
    <Copyright>Copyright (c) 2026 rndadhdman. MIT License.</Copyright>
    <!-- No culture-specific formatting is used; this also removes the libicu dependency on Linux. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <!-- Publishing: one executable. Windows bundles the native Skia libraries inside the exe;
       Linux keeps them next to it so nothing is extracted at startup (works in Flatpak too). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.23" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\icon-256.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EyesSaver.Core\EyesSaver.Core.csproj" />
  </ItemGroup>
</Project>
