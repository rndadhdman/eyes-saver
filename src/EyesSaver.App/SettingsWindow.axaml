<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:EyesSaver.App"
        x:Class="EyesSaver.App.SettingsWindow"
        Title="Eyes Saver"
        Width="980" Height="720" MinWidth="840" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Icon="avares://EyesSaver/Assets/icon-256.png"
        Background="{DynamicResource Es.Window}"
        Foreground="{DynamicResource Es.Text}"
        FontSize="13.5">
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20,16,20,12">

    <!-- Header -->
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
      <Image Source="avares://EyesSaver/Assets/icon-256.png" Width="46" Height="46" Margin="0,0,12,0"
             RenderOptions.BitmapInterpolationMode="HighQuality" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
        <TextBlock Classes="title" Text="Eyes Saver" />
        <TextBlock x:Name="StatusText" Classes="muted" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <ToggleSwitch x:Name="MasterSwitch" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"
                    OnContent="Tint active" OffContent="Tint paused" />
    </Grid>

    <!-- Displays and tint -->
    <Grid Grid.Row="1" ColumnDefinitions="*,12,380">
      <Border Classes="card">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="section" Text="Displays" VerticalAlignment="Center" />
            <Button x:Name="IdentifyButton" Grid.Column="1" Classes="secondary" Content="Identify" Margin="6,0,0,0"
                    ToolTip.Tip="Show each display's number on the screen itself" />
            <Button x:Name="RescanButton" Grid.Column="2" Classes="secondary" Content="Rescan" Margin="6,0,0,0"
                    ToolTip.Tip="Read the display layout again. This also happens on its own when displays change." />
          </Grid>
          <TextBlock x:Name="DisplaysSubtitle" DockPanel.Dock="Top" Classes="muted" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
          <TextBlock DockPanel.Dock="Bottom" Classes="muted small" TextWrapping="Wrap"
                     Text="Click a display to set it up on its own. Click the empty space to set up all of them." />
          <local:MonitorMap x:Name="Map" Margin="0,10,0,10" FontSize="12" />
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Classes="card">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Classes="section" Text="Tint" Margin="0,0,0,10" />
            <WrapPanel x:Name="Chips" Margin="0,0,0,6" />
            <TextBlock x:Name="TargetName" Classes="section" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            <TextBlock x:Name="TargetDetail" Classes="muted small" TextTrimming="CharacterEllipsis" Margin="0,2,0,4" />
            <ToggleSwitch x:Name="EnabledSwitch" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
              <TextBlock Classes="strong" Text="Intensity" VerticalAlignment="Center" />
              <TextBlock x:Name="IntensityValue" Grid.Column="1" Classes="strong" VerticalAlignment="Center" />
            </Grid>
            <Slider x:Name="IntensitySlider" Minimum="0" Maximum="90" SmallChange="1" LargeChange="5"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    ToolTip.Tip="Drag, scroll, or use the arrow keys" />

            <TextBlock Classes="strong" Text="Color" Margin="0,8,0,8" />
            <WrapPanel x:Name="Swatches" />
            <TextBlock x:Name="ColorDescription" Classes="muted small" TextWrapping="Wrap" Margin="0,2,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Options -->
    <Border Grid.Row="2" Classes="card" Margin="0,12,0,8" Padding="18,10,18,12">
      <StackPanel Spacing="2">
        <WrapPanel>
          <ToggleSwitch x:Name="StartupSwitch" Margin="0,0,28,0" />
          <ToggleSwitch x:Name="CaptureSwitch" Margin="0,0,28,0"
                        OnContent="Keep tint out of screenshots and screen sharing"
                        OffContent="Keep tint out of screenshots and screen sharing"
                        ToolTip.Tip="You still see the tint. Screenshots, recordings and people watching your screen share do not." />
          <ToggleSwitch x:Name="HotkeySwitch" OnContent="Keyboard shortcuts" OffContent="Keyboard shortcuts" />
        </WrapPanel>
        <TextBlock x:Name="HotkeyHint" Classes="muted small" TextWrapping="Wrap" Margin="2,0,0,0" />
      </StackPanel>
    </Border>

    <!-- Footer -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
      <TextBlock x:Name="FooterText" Classes="muted small" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button x:Name="QuitButton" Grid.Column="1" Classes="ghost" Content="Quit Eyes Saver"
              ToolTip.Tip="Remove the tint and close the app" />
    </Grid>
  </Grid>
</Window>
